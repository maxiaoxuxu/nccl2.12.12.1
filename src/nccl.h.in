 * 显式值：1
 */
               ncclUnhandledCudaError      =  1,
/* 中文逐项-枚举项 X1181：ncclSystemError
 * 所属枚举中的命名取值；名称表达对应状态/能力/类别，使用字段和下方值决定协议编码。
 * 显式值：2
 */
               ncclSystemError             =  2,
/* 中文逐项-枚举项 X1182：ncclInternalError
 * 所属枚举中的命名取值；名称表达对应状态/能力/类别，使用字段和下方值决定协议编码。
 * 显式值：3
 */
               ncclInternalError           =  3,
/* 中文逐项-枚举项 X1183：ncclInvalidArgument
 * 所属枚举中的命名取值；名称表达对应状态/能力/类别，使用字段和下方值决定协议编码。
 * 显式值：4
 */
