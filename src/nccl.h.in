#ifndef NCCL_H_
/* 中文逐项-常量 X1172：NCCL_H_
 * 编译期定义：NCCL_H_ = <空替换体>。
 * 下方预处理条件决定该定义何时有效；空替换体常作头文件保护/能力开关，数值/字符串/类型别名需按实际替换内容解释。
 */
#define NCCL_H_

#include <cuda_runtime.h>
#include <cuda_fp16.h>
#if CUDART_VERSION >= 11000
#include <cuda_bf16.h>
#endif

/* 中文逐项-常量 X1173：NCCL_MAJOR
 * 编译期定义：NCCL_MAJOR = ${nccl:Major}。
 * 下方预处理条件决定该定义何时有效；空替换体常作头文件保护/能力开关，数值/字符串/类型别名需按实际替换内容解释。
 */
#define NCCL_MAJOR ${nccl:Major}
/* 中文逐项-常量 X1174：NCCL_MINOR
 * 编译期定义：NCCL_MINOR = ${nccl:Minor}。
 * 下方预处理条件决定该定义何时有效；空替换体常作头文件保护/能力开关，数值/字符串/类型别名需按实际替换内容解释。
 */
#define NCCL_MINOR ${nccl:Minor}
/* 中文逐项-常量 X1175：NCCL_PATCH
 * 编译期定义：NCCL_PATCH = ${nccl:Patch}。
 * 下方预处理条件决定该定义何时有效；空替换体常作头文件保护/能力开关，数值/字符串/类型别名需按实际替换内容解释。
 */
#define NCCL_PATCH ${nccl:Patch}
/* 中文逐项-常量 X1176：NCCL_SUFFIX
 * 编译期定义：NCCL_SUFFIX = "${nccl:Suffix}"。
 * 下方预处理条件决定该定义何时有效；空替换体常作头文件保护/能力开关，数值/字符串/类型别名需按实际替换内容解释。
 */
#define NCCL_SUFFIX "${nccl:Suffix}"

/* 中文逐项-常量 X1177：NCCL_VERSION_CODE
 * 编译期定义：NCCL_VERSION_CODE = ${nccl:Version}。
 * 下方预处理条件决定该定义何时有效；空替换体常作头文件保护/能力开关，数值/字符串/类型别名需按实际替换内容解释。
 */
#define NCCL_VERSION_CODE ${nccl:Version}
/* 中文逐项-宏 M0146：NCCL_VERSION
 * 宏职责：用下面的参数与展开式生成编译期表达式/调用包装；调用实参会原样替换，必须注意括号、求值次数及返回/跳转副作用。
 * 原始宏名 NCCL_VERSION；完整替换体紧邻下方，续行反斜线属于宏定义的一部分。注释放在宏定义外，未改替换体。
 */
#define NCCL_VERSION(X,Y,Z) (((X) <= 2 && (Y) <= 8) ? (X) * 1000 + (Y) * 100 + (Z) : (X) * 10000 + (Y) * 100 + (Z))

#ifdef __cplusplus
extern "C" {
#endif

/* Opaque handle to communicator */
typedef struct ncclComm* ncclComm_t;

/* 中文逐项-常量 X1178：NCCL_UNIQUE_ID_BYTES
 * 编译期定义：NCCL_UNIQUE_ID_BYTES = 128。
 * 下方预处理条件决定该定义何时有效；空替换体常作头文件保护/能力开关，数值/字符串/类型别名需按实际替换内容解释。
 */
#define NCCL_UNIQUE_ID_BYTES 128
typedef /* 中文逐项-类型 T0394：ncclUniqueId
 * 类型职责：应用负责分发给全组rank的不透明bootstrap会合标识，不包含完整用户数据。
 * 声明内可见成员（含嵌套成员）：internal。各字段在声明旁逐项解释，不假设同名字段在别的结构中含义相同。
 */struct { /* 中文逐项-变量 V3561：internal
 * internal（char；成员 ncclUniqueId）：控制/连接的内部描述或transport类型编号，用于选择正确后台回调。
 */char internal[NCCL_UNIQUE_ID_BYTES]; } ncclUniqueId;

/* Error type */
