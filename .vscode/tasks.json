{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NCCL：查看当前代码图解",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/open_source_diagram.py",
        "--file",
        "${file}",
        "--line",
        "${lineNumber}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
